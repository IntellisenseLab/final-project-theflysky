.vscode/

# ROS 2 / colcon generated artifacts
**/build/
**/install/
**/log/

# Python virtual environment (rebuild natively per-machine; never commit -
# committing it shipped x86_64 wheels that broke the arm64 Pi)
.venv/
venv/

# Python bytecode caches
__pycache__/

# Test and lint artifacts (caches and reports, not test sources)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
coverage.xml
*.pyc

# Optional local lint/test config files
.flake8
pytest.ini
tox.ini
CLAUDE.md
instructions